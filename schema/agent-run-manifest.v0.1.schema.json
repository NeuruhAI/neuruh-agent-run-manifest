{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuruh.ai/schemas/agent-run-manifest.v0.1.schema.json",
  "title": "Neuruh Agent Run Manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","run_id","actor_id","mission","started_at","ended_at","status","components","policy","inference","inputs","evidence","decisions","executions","receipts","outputs","manifest_digest"],
  "properties": {
    "schema_version": {"const": "neuruh.agent-run-manifest.v0.1"},
    "run_id": {"type":"string","minLength":1},
    "actor_id": {"type":"string","minLength":1},
    "mission": {"type":"string","minLength":1},
    "started_at": {"type":"string","format":"date-time"},
    "ended_at": {"type":"string","format":"date-time"},
    "status": {"enum":["completed","denied","escalated","failed","dry_run"]},
    "components":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/component"}},
    "policy":{"$ref":"#/$defs/policy"},
    "inference":{"$ref":"#/$defs/inference"},
    "inputs":{"type":"array","items":{"$ref":"#/$defs/artifact"}},
    "evidence":{"type":"array","items":{"$ref":"#/$defs/evidence"}},
    "decisions":{"type":"array","items":{"$ref":"#/$defs/decision"}},
    "executions":{"type":"array","items":{"$ref":"#/$defs/execution"}},
    "receipts":{"type":"array","items":{"$ref":"#/$defs/receipt"}},
    "outputs":{"type":"array","items":{"$ref":"#/$defs/artifact"}},
    "manifest_digest":{"$ref":"#/$defs/sha256ref"}
  },
  "$defs": {
    "sha256ref":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "receiptHash":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "gitCommit":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "artifact":{
      "type":"object","additionalProperties":false,
      "required":["artifact_id","sha256","media_type"],
      "properties":{"artifact_id":{"type":"string","minLength":1},"sha256":{"$ref":"#/$defs/sha256ref"},"media_type":{"type":"string","minLength":1}}
    },
    "component":{
      "type":"object","additionalProperties":false,
      "required":["name","version"],
      "properties":{"name":{"type":"string","minLength":1},"version":{"type":"string","minLength":1},"source_commit":{"$ref":"#/$defs/gitCommit"}}
    },
    "policy":{
      "type":"object","additionalProperties":false,
      "required":["policy_id","policy_version"],
      "properties":{"policy_id":{"type":"string","minLength":1},"policy_version":{"$ref":"#/$defs/sha256ref"}}
    },
    "inference":{
      "type":"object","additionalProperties":false,
      "required":["backend","model","health"],
      "properties":{"backend":{"type":["string","null"]},"model":{"type":["string","null"]},"health":{"enum":["healthy","degraded","unavailable","not_used"]}}
    },
    "evidence":{
      "type":"object","additionalProperties":false,
      "required":["evidence_id","sha256","state"],
      "properties":{"evidence_id":{"type":"string","minLength":1},"sha256":{"$ref":"#/$defs/sha256ref"},"state":{"enum":["supported","observed","abstained","contradicted"]}}
    },
    "decision":{
      "type":"object","additionalProperties":false,
      "required":["action_id","decision","policy_version","sha256"],
      "properties":{"action_id":{"type":"string","minLength":1},"decision":{"enum":["allow","deny","escalate"]},"policy_version":{"$ref":"#/$defs/sha256ref"},"sha256":{"$ref":"#/$defs/sha256ref"}}
    },
    "execution":{
      "type":"object","additionalProperties":false,
      "required":["execution_id","capability","status","decision_action_id","receipt_id","sha256"],
      "properties":{"execution_id":{"type":"string","minLength":1},"capability":{"type":"string","minLength":1},"status":{"enum":["executed","dry_run","failed","not_started"]},"decision_action_id":{"type":"string","minLength":1},"receipt_id":{"type":["string","null"]},"sha256":{"$ref":"#/$defs/sha256ref"}}
    },
    "receipt":{
      "type":"object","additionalProperties":false,
      "required":["receipt_id","seq","entry_hash"],
      "properties":{"receipt_id":{"type":"string","minLength":1},"seq":{"type":"integer","minimum":0},"entry_hash":{"$ref":"#/$defs/receiptHash"}}
    }
  }
}
